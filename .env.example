XANGI_URL=http://127.0.0.1:18888
# Optional: set this only when the connected xangi requires a bearer token.
XANGI_TOKEN=

HOST=127.0.0.1
PORT=4173
AVATAR_VOICEVOX_URL=http://127.0.0.1:50021
AVATAR_WHISPER_MODEL=medium
AVATAR_WHISPER_DEVICE=auto
# Optional shared voice service; otherwise use the local worker.
AVATAR_VOICE_URL=
# Optional existing Python with CUDA-capable torch and openai-whisper.
# AVATAR_VOICE_PYTHON=/absolute/path/to/venv/bin/python
# Optional: move server-side custom character settings outside this checkout.
AVATAR_CHARACTER_SETTINGS_FILE=
# Optional: enable image-backed conversation logs for screen conversations.
NOTION_API_KEY=
# Optional alternative to NOTION_API_KEY. Use an absolute path to a mode-0600 token file.
NOTION_API_KEY_FILE=
NOTION_CONVERSATION_PARENT_PAGE_ID=

# Managed extension only. Put these in the persistent data directory's config.env.
# Managed mode allocates a loopback port and uses the xangi host UI URL.
# AVATAR_DATA_DIR=/absolute/path/to/avatar-data
# AVATAR_VOICE_ROOT=/absolute/path/to/avatar-data/voice

# Standalone mode only: optional Tailscale Serve identity authentication.
# Keep the backend on loopback; Serve must preserve the public Host.
# AVATAR_PUBLIC_URL=https://your-device.your-tailnet.ts.net:4173/
# AVATAR_TRUSTED_TAILSCALE_LOGIN=you@example.com
